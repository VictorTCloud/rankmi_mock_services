# Copia a cloudflared/config.yml y ajusta hostname y UUID del túnel.
# Coloca el JSON de credenciales en cloudflared/<TUNNEL_UUID>.json (no lo subas a git).

tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: /etc/cloudflared/REPLACE_WITH_TUNNEL_UUID.json

# El mock sigue exigiendo Authorization: Bearer <MOCK_TOKEN>.
ingress:
  - hostname: mock-seguros.example.com
    service: http://mock:8080
  - service: http_status:404
