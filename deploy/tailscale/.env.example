MOCK_TOKEN=replace-with-a-long-random-secret

# Nombre en MagicDNS (p. ej. https://mock-seguros en el admin de Tailscale).
TS_HOSTNAME=mock-seguros

# Clave de un solo uso o reusable con ACL que permita tag:mock-seguros.
# Crear en: https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
