# --- Mock (obligatorio para run.sh) ---

# Secreto largo; los clientes envían: Authorization: Bearer <MOCK_TOKEN>
MOCK_TOKEN=replace-with-a-long-random-secret

# Escucha en todas las interfaces del host (necesario para peers del tailnet)
MOCK_HOST=0.0.0.0
MOCK_PORT=8080

# --- Tailscale (no las usa run.sh; solo para setup-tailscale.sh / tu shell) ---

# Clave reusable del admin (Settings → Keys). Omítela si haces `tailscale up` interactivo.
# TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx

# Hostname del nodo → mock-seguros.<tailnet>.ts.net con MagicDNS
TS_HOSTNAME=mock-seguros

# Puerto HTTPS en el tailnet al usar serve-tailscale.sh (opcional)
TAILSCALE_SERVE_PORT=443
